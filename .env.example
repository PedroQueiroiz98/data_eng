# ─── Copie para .env e ajuste. NUNCA coloque secrets reais aqui. ───
#
# Todas as chaves usam o prefixo NBP_ de propósito, para não colidir com
# variáveis já exportadas no seu shell (POSTGRES_PASSWORD, REDIS_URL, ...).
# Todas são opcionais — o docker-compose.yml traz defaults equivalentes.

# Ambiente: dev | prod
NBP_APP_ENV=dev
NBP_LOG_LEVEL=INFO

# ─── Conexões (hostnames = nomes dos serviços na rede do compose) ───
NBP_DATABASE_URL=postgresql+asyncpg://nbplatform:nbplatform@postgres:5432/nbplatform
NBP_REDIS_URL=redis://redis:6379/0

# ─── Segurança (Fase 8) ───
# Chave Fernet base64 urlsafe de 32 bytes. Gere uma real fora do controle de versão:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NBP_SECRET_ENCRYPTION_KEY=iY0uDAIk3AqhPlmaVTZOGf-Bajj5kjmIDRZiwqRLvDc=
NBP_JWT_SECRET=dev-only-change-me-jwt-secret-0123456789abcdef
NBP_JWT_EXPIRE_MINUTES=720
NBP_ADMIN_EMAIL=admin@nbplatform.local
NBP_ADMIN_PASSWORD=admin

# ─── Sandbox de execução: subprocess (dev) | docker (hardened) ───
# 'docker' exige montar /var/run/docker.sock no serviço worker (profile "docker" do compose).
NBP_EXECUTION_SANDBOX=subprocess
NBP_SANDBOX_IMAGE=nbplatform-backend
NBP_SANDBOX_CPUS=1
NBP_SANDBOX_MEMORY=512m

# ─── Limites de concorrência ───
NBP_MAX_CONCURRENT_JOBS=5
NBP_MAX_CONCURRENT_EXECUTIONS=5

# ─── Execução ───
NBP_EXECUTION_TIMEOUT_S=1800
NBP_WORKER_HEARTBEAT_INTERVAL_S=10
NBP_WORKER_LEASE_TIMEOUT_S=60
NBP_RECOVERY_INTERVAL_S=30

# ─── Workspace ───
# Raiz física de todos os Workspaces. No compose é um volume nomeado; em
# execução local (sem Docker) aponte para uma pasta real e gravável.
NBP_WORKSPACES_DIR=/data/workspaces

# ─── Retry (política padrão de execuções avulsas) ───
NBP_EXECUTION_MAX_RETRIES=2
NBP_EXECUTION_RETRY_INITIAL_DELAY_S=10
NBP_EXECUTION_RETRY_BACKOFF_MULTIPLIER=2
NBP_EXECUTION_RETRY_MAX_DELAY_S=300
# ANY | TRANSIENT_ONLY
NBP_EXECUTION_RETRY_MODE=TRANSIENT_ONLY

# ─── Portas expostas no host ───
# Troque se a porta já estiver ocupada (ex.: Postgres local em 5432).
# Só afeta o bind no host, não a comunicação entre containers.
NBP_POSTGRES_PORT=5432
NBP_REDIS_PORT=6379
NBP_BACKEND_PORT=8000
NBP_FRONTEND_PORT=5173

# ─── Frontend ───
NBP_VITE_API_BASE_URL=/api
NBP_VITE_WS_BASE_URL=/ws
