# ─── Copie para .env e ajuste. NUNCA coloque secrets reais aqui. ───
#
# Todas as chaves usam o prefixo NBP_ de propósito, para não colidir com
# variáveis já exportadas no seu shell (POSTGRES_PASSWORD, REDIS_URL, ...).
# Todas são opcionais — o docker-compose.yml traz defaults equivalentes.

# Ambiente: dev | prod
NBP_APP_ENV=dev
NBP_LOG_LEVEL=INFO

# ─── Conexões (hostnames = nomes dos serviços na rede do compose) ───
NBP_DATABASE_URL=postgresql+asyncpg://nbplatform:nbplatform@postgres:5432/nbplatform
NBP_REDIS_URL=redis://redis:6379/0

# ─── Criptografia de secrets (Fase 8) ───
# Chave Fernet base64 urlsafe de 32 bytes. Gere uma real fora do controle de versão:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NBP_SECRET_ENCRYPTION_KEY=CHANGE_ME_generate_a_real_fernet_key_base64_32bytes=

# ─── Limites de concorrência ───
NBP_MAX_CONCURRENT_JOBS=5
NBP_MAX_CONCURRENT_EXECUTIONS=5

# ─── Execução ───
NBP_EXECUTION_TIMEOUT_S=1800
NBP_WORKER_HEARTBEAT_INTERVAL_S=10
NBP_WORKER_LEASE_TIMEOUT_S=60

# ─── Portas expostas no host ───
# Troque se a porta já estiver ocupada (ex.: Postgres local em 5432).
# Só afeta o bind no host, não a comunicação entre containers.
NBP_POSTGRES_PORT=5432
NBP_REDIS_PORT=6379
NBP_BACKEND_PORT=8000
NBP_FRONTEND_PORT=5173

# ─── Frontend ───
NBP_VITE_API_BASE_URL=/api
NBP_VITE_WS_BASE_URL=/ws
